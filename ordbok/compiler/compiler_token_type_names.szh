-- compiler_token_type_names.szh
-- Self-describing: the compiler's TokenType display strings.
-- Emits to include/gen/token_type_names.h via --target c.
-- M2 milestone: replaces hand-written token_type_name() in token.c.

import compiler_token_types

projection token_type_name :
  invariant ξ tok
  yields ω label
  cases:
    ident -> "identifier"
    number -> "number"
    string -> "string"
    xi -> "ξ"
    zeta -> "ζ"
    x -> "x"
    rk -> "R.k"
    omega -> "ω"
    delta_rk -> "ΔR.k"
    unit -> "unit"
    zero -> "zero"
    magnitude -> "magnitude"
    vector -> "vector"
    dimension -> "dimension"
    dependency -> "dependency"
    containment -> "containment"
    morphism -> "morphism"
    projection -> "projection"
    traversal -> "traversal"
    incommensurable -> "incommensurable"
    commensurable -> "commensurable"
    perpendicular -> "perpendicular"
    invariant -> "invariant"
    context -> "context"
    data -> "data"
    operator -> "operator"
    output -> "output"
    cast -> "cast"
    identity -> "identity"
    yields -> "yields"
    cases -> "cases"
    from -> "from"
    through -> "through"
    yield -> "yield"
    carries -> "carries"
    structure -> "structure"
    opens -> "opens"
    governed_by -> "governed_by"
    preserves -> "preserves"
    changes -> "changes"
    meihua -> "meihua"
    zhulin -> "zhulin"
    songqiao -> "songqiao"
    decidable -> "decidable"
    undecidable -> "undecidable"
    import -> "import"
    if -> "if"
    then -> "then"
    else -> "else"
    colon -> ":"
    pipe -> "|"
    arrow -> "->"
    fat_arrow -> "=>"
    comma -> ","
    dot -> "."
    lparen -> "("
    rparen -> ")"
    lbracket -> "["
    rbracket -> "]"
    lbrace -> "{"
    rbrace -> "}"
    semicolon -> ";"
    question -> "?"
    double_question -> "??"
    star -> "*"
    plus -> "+"
    minus -> "-"
    slash -> "/"
    percent -> "%"
    caret -> "^"
    bang -> "!"
    bang_eq -> "!="
    lt -> "<"
    gt -> ">"
    lt_eq -> "<="
    gt_eq -> ">="
    and_and -> "&&"
    or_or -> "||"
    cross -> "×"
    equals -> "="
    double_equals -> "=="
    pipe_arrow -> "|>"
    underscore -> "_"
    indent -> "INDENT"
    dedent -> "DEDENT"
    newline -> "NEWLINE"
    comment -> "comment"
    eof -> "EOF"
    error -> "ERROR"
    count -> "<count>"
