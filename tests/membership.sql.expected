-- projection role_label
CREATE OR REPLACE FUNCTION resolve_role_label(
  p_structural_role text,
  p_resource_type text
) RETURNS text
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE
    WHEN p_structural_role = 'owner' AND p_resource_type = 'group' THEN 'Owner'
    WHEN p_structural_role = 'admin' AND p_resource_type = 'group' THEN 'Admin'
    WHEN p_structural_role = 'owner' AND p_resource_type = 'league' THEN 'Commissioner'
    WHEN p_structural_role = 'admin' AND p_resource_type = 'league' THEN 'Captain'
  END
$$;

