 * invariant (ξ): structural_role
 * context (ζ):   resource_type
 * yields (ω):    label
 */
export function resolveRoleLabel(
  structuralRole: string,
  resourceType: string
): string {
  if (structuralRole === 'owner' && resourceType === 'group') return 'Owner';
  if (structuralRole === 'admin' && resourceType === 'group') return 'Admin';
  if (structuralRole === 'owner' && resourceType === 'league') return 'Commissioner';
  if (structuralRole === 'admin' && resourceType === 'league') return 'Captain';

  return defaultFor(structuralRole);
}

