-- projection color_label
CREATE OR REPLACE FUNCTION resolve_color_label(
  p_color text,
  p_size text
) RETURNS text
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE
    WHEN p_color = 'red' AND p_size = 'small' THEN 'Small Red'
    WHEN p_color = 'red' AND p_size = 'medium' THEN 'Medium Red'
    WHEN p_color = 'red' AND p_size = 'large' THEN 'Large Red'
    WHEN p_color = 'green' AND p_size = 'small' THEN 'Small Green'
    WHEN p_color = 'green' AND p_size = 'medium' THEN 'Medium Green'
    WHEN p_color = 'green' AND p_size = 'large' THEN 'Large Green'
    WHEN p_color = 'blue' AND p_size = 'small' THEN 'Small Blue'
    WHEN p_color = 'blue' AND p_size = 'medium' THEN 'Medium Blue'
    WHEN p_color = 'blue' AND p_size = 'large' THEN 'Large Blue'
    ELSE 'Unknown'
  END
$$;

