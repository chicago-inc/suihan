-- meihua safe_divide — pure computation
CREATE OR REPLACE FUNCTION safe_divide(
  p_a double precision,
  p_b double precision
) RETURNS double precision
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE WHEN (p_b = 0) THEN 0 ELSE (p_a / p_b) END
$$;

-- meihua clamp_v2 — pure computation
CREATE OR REPLACE FUNCTION clamp_v2(
  p_value double precision,
  p_low double precision,
  p_high double precision
) RETURNS double precision
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE WHEN (p_value < p_low) THEN p_low ELSE CASE WHEN (p_value > p_high) THEN p_high ELSE p_value END END
$$;

-- meihua abs_value — pure computation
CREATE OR REPLACE FUNCTION abs_value(
  p_x double precision
) RETURNS double precision
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE WHEN (p_x < 0) THEN (-p_x) ELSE p_x END
$$;

-- meihua sign — pure computation
CREATE OR REPLACE FUNCTION sign(
  p_n double precision
) RETURNS double precision
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE WHEN (p_n > 0) THEN 1 ELSE CASE WHEN (p_n < 0) THEN (-1) ELSE 0 END END
$$;


