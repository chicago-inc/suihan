-- projection permission_matrix
CREATE OR REPLACE FUNCTION resolve_permission_matrix(
  p_role text,
  p_action text
) RETURNS text
  LANGUAGE sql
  IMMUTABLE
AS $$
  SELECT CASE
    WHEN p_role = 'owner' AND p_action = 'edit' THEN 'true'
    WHEN p_role = 'owner' AND p_action = 'delete' THEN 'true'
    WHEN p_role = 'admin' AND p_action = 'edit' THEN 'true'
    WHEN p_role = 'admin' AND p_action = 'delete' THEN 'false'
    WHEN p_role = 'member' THEN 'false'
    ELSE 'denied'
  END
$$;

