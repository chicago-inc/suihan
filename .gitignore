# Build artifacts
build/
build[0-9]*/
*.o
*.d

# Compiler binaries
suhc
suhc[0-9]*
suhc.exe
*.exe

# Generated outputs (regenerated by suhc from .szh source)
ordbok/*.h
ordbok/*.sql
ordbok/*.ts
ordbok/compiler/*.h

# Test generated outputs (regenerated by run_tests.sh)
tests/*.h
tests/*.sql
tests/*.ts
tests/stress/*.h
tests/stress/*.sql
tests/stress/*.ts

# Transient state
.suhc_history
.convergence.json
